---
import Pip from "./Pip.astro";
import { APP_URL } from "../site";
---
<section id="cta" class="mx-auto flex max-w-3xl flex-col items-center gap-6 px-5 py-20 text-center md:py-28" data-reveal>
  <Pip mood="cheer" size={170} />
  <h2 class="text-[clamp(2rem,1.5rem+2vw,3rem)] leading-[1.12]">Your first lesson takes five minutes.</h2>
  <a href={`${APP_URL}/welcome`} id="cta-start" class="btn btn-sea w-full max-w-sm">Get started</a>
</section>
