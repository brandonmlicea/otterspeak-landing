---
interface Props { id: string; eyebrow: string; title: string; flip?: boolean }
const { id, eyebrow, title, flip = false } = Astro.props;
---
<section id={id} class="mx-auto grid max-w-5xl items-center gap-10 px-5 py-16 md:grid-cols-2 md:gap-16 md:py-24">
  <div class:list={["min-w-0 text-center md:text-left", flip && "md:order-2"]} data-reveal>
    <p class="eyebrow">{eyebrow}</p>
    <h2 class="mt-3 text-[clamp(1.9rem,1.4rem+1.8vw,2.5rem)] leading-[1.15]">{title}</h2>
    <div class="mt-4 text-[17px] leading-relaxed text-body"><slot /></div>
  </div>
  <div class="mx-auto w-full max-w-md min-w-0" data-reveal><slot name="art" /></div>
</section>
