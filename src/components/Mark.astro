---
interface Props { hue: number; mark: string; size?: number }
const { hue, mark, size = 40 } = Astro.props;
---
<span aria-hidden="true" class="inline-grid shrink-0 place-items-center rounded-xl font-extrabold text-white" style={`width:${size}px;height:${size * 0.74}px;font-size:${size * 0.32}px;background:oklch(0.52 0.13 ${hue});box-shadow:inset 0 -${size / 14}px 0 oklch(0.42 0.12 ${hue})`}>{mark}</span>
