---
import "../styles/global.css";
import Pip from "../components/Pip.astro";
import { APP_URL, GITHUB, LANDING_SRC } from "../site";
const title = "Otterspeak · Learn anything in five minutes a day";
const description = "Bite-sized lessons in languages, math or any topic you type, coached by Pip the otter. Free and open source.";
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#187c49" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <script is:inline>document.documentElement.classList.add("js")</script>
  </head>
  <body>
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:rounded-lg focus:bg-surface focus:px-4 focus:py-2">Skip to content</a>
    <header id="nav" class="sticky top-0 z-20 border-b border-line bg-canvas/85 backdrop-blur">
      <div class="mx-auto flex max-w-6xl items-center justify-between px-5 py-3">
        <a href="/" id="logo" class="flex items-center gap-2 font-serif text-[28px] leading-none tracking-tight text-ink">
          <Pip size={36} />
          otterspeak
        </a>
        <nav class="flex items-center gap-5 text-[15px]">
          <a href={GITHUB} id="nav-github" class="text-muted hover:text-sea-ink">GitHub</a>
          <a href={`${APP_URL}/welcome`} id="nav-start" class="btn btn-sea hidden h-9 px-4 text-sm sm:inline-flex">Get started</a>
        </nav>
      </div>
    </header>
    <main id="main"><slot /></main>
    <footer id="footer" class="border-t border-line">
      <div class="mx-auto flex max-w-6xl flex-col gap-4 px-5 py-10 text-sm text-muted sm:flex-row sm:items-center sm:justify-between">
        <nav class="flex flex-wrap gap-x-6 gap-y-2 text-ink">
          <a href={APP_URL} class="hover:text-sea-ink">App</a>
          <a href={GITHUB} class="hover:text-sea-ink">GitHub</a>
          <a href={LANDING_SRC} class="hover:text-sea-ink">Landing source</a>
          <a href={`${GITHUB}/blob/main/LICENSE`} class="hover:text-sea-ink">MIT license</a>
        </nav>
        <p>Pip and Otterspeak are original; not affiliated with Duolingo.</p>
      </div>
    </footer>
    <script>import "../scripts/motion";</script>
  </body>
</html>
